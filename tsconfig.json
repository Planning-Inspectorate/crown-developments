{
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "packages/database/src/client/**", "**/*.test.ts", "dist", "build", "tmp", "run", "web"],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"checkJs": false,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"strict": true,
		"target": "esnext",
		"skipLibCheck": true,
		"typeRoots": ["./node_modules/@types", "./packages/lib/types"]
	}
}
