{# 
    Table that shows a list of documents / files.
    - documentsList: Array of document objects
    - showCheckboxes: Boolean
    - config: Object for overriding default table text (e.g., { dateHeader: 'Date modified' })
#}
{% macro documentsTable(documentsList, showCheckboxes=false, config={}) %}

    {% set dateHeader = config.dateHeader | default('Uploaded') %}
    {% set actionsHeader = config.actionsHeader | default('Actions') %}

    {% set rows = [] %}

    {% for doc in documentsList %}
        {% set rowItems = [] %}

        {% if showCheckboxes %}
            {% set checkboxHtml %}
                <div class="govuk-checkboxes__item govuk-checkboxes--small mo-checkbox-table-cell">
                    <input class="govuk-checkboxes__input" id="select-file-{{ doc.id }}" name="selectedFiles" type="checkbox" value="{{ doc.id }}" data-cy="file-checkbox-{{ doc.id }}">
                    <label class="govuk-label govuk-checkboxes__label" for="select-file-{{ doc.id }}">
                        <span class="govuk-visually-hidden">Select {{ doc.fileName }}</span>
                    </label>
                </div>
            {% endset %}
            {% set rowItems = (rowItems.push({ html: checkboxHtml }), rowItems) %}
        {% endif %}

        {% set fileLinkHtml %}
            {% if doc.isPreview %}
                <a id="row-{{ doc.id }}" class="govuk-link govuk-!-font-weight-bold" href="{{ doc.downloadHref }}?preview=true" target="_blank" data-cy="file-link-{{ doc.id }}">
                    {{ doc.fileName }}
                </a>
            {% else %}
                <p id="row-{{ doc.id }}" class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1" data-cy="file-name-{{ doc.id }}">
                    {{ doc.fileName }}
                </p>
            {% endif %}
            
            <div class="govuk-hint govuk-!-margin-top-1 govuk-!-margin-bottom-0">
                {% if doc.hint %}
                    {{ doc.hint }}
                {% else %}
                    File type and size: {{ doc.fileType | upper }}, {{ doc.size }}
                {% endif %}
            </div>
        {% endset %}

        {% set rowItems = (rowItems.push({
            html: fileLinkHtml,
            attributes: { "data-sort-value": doc.fileName | lower }
        }), rowItems) %}

        {% set rowItems = (rowItems.push({
            text: doc.date,
            attributes: { "data-sort-value": doc.dateSort }
        }), rowItems) %}

        {% set actionsHtml %}
            {% if doc.actions and doc.actions | length > 0 %}
                <ul class="govuk-summary-list__actions-list">
                    {% for action in doc.actions %}
                        <li class="govuk-summary-list__actions-list-item">
                            <a class="govuk-link govuk-link--no-visited-state {{ action.classes }}" href="{{ action.href }}" {% for attr, val in action.attributes %} {{ attr }}="{{ val }}"{% endfor %}>
                                {{ action.text }}<span class="govuk-visually-hidden"> {{ doc.fileName }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% elif doc.downloadHref %}
                {# Fallback for backwards compatibility if no actions array is provided #}
                <a class='govuk-link govuk-!-margin-bottom-2' href="{{ doc.downloadHref }}" data-cy="download-file-{{ doc.id }}">Download</a>
            {% endif %}
        {% endset %}

        {% set rowItems = (rowItems.push({ html: actionsHtml }), rowItems) %}
        {% set rows = (rows.push(rowItems), rows) %}
    {% endfor %}

    {% set headers = [] %}

    {% if showCheckboxes %}
        {% set selectAllHtml %}
            <div class="govuk-checkboxes__item govuk-checkboxes--small mo-checkbox-table-cell">
                <input type="checkbox" class="govuk-checkboxes__input" id="checkboxes-all" name="checkboxes-all" value="all" data-cy="select-all-files">
                <label class="govuk-label govuk-checkboxes__label" for="checkboxes-all">
                    <span class="govuk-!-font-weight-bold">All files</span>
                </label>
            </div>
        {% endset %}
        {% set headers = (headers.push({ html: selectAllHtml }), headers) %}
    {% endif %}

    {% set headers = (headers.push(
        { text: 'File name', attributes: { "aria-sort": "none" }, classes: "govuk-!-width-one-third" },
        { text: dateHeader, attributes: { "aria-sort": "descending" } },
        { text: actionsHeader }
    ), headers) %}

    {{ govukTable({
        attributes: {
            "data-module": "moj-sortable-table",
            "data-cy": "documents-table"
        },
        head: headers,
        rows: rows,
        classes: "pins-documents-table"
    }) }}

{% endmacro %}

{# 
    Table that shows a list of case notes.
    - caseNotes: Array of case notes 
    - displayRef: Boolean
#}
{% macro caseNotesTable(caseNotes,displayRef=true) %}
        {% if caseNotes | length == 0 %}
            <p class="govuk-body" data-cy="no-notes-message">There are no case notes to display</p>
        {% else %}            
            {% set tableRows = [] %}
            {% for note in caseNotes %}
                {% set tableRows = (tableRows.push([
                    {
                        html: note.date + "<br>" + note.time,
                        attributes: { "data-cy": "note-date-" + loop.index0 }
                    },
                    {
                        html: note.commentText,
                        attributes: { "data-cy": "note-comment-" + loop.index0 },
                        classes: "govuk-!-text-break-word"
                    },
                    {
                        text: note.userName,
                        attributes: { "data-cy": "note-user-" + loop.index0 }
                    }
                ]), tableRows) %}
            {% endfor %}

            {{ govukTable({
                attributes: {
                    "data-cy": "case-notes-table"
                },
                head: [
                    { text: "Date and time", classes: "govuk-!-width-one-quarter" },
                    { text: "Details" },
                    { text: "User", classes: "govuk-!-width-one-quarter" }
                ],
                rows: tableRows
            }) }}
        {% endif %}
{% endmacro %}