{% macro chevronCard(title, href, description) %}
	<div class="pins-chevron-card">
		<div class="pins-chevron-card__wrapper">
			<h3 class="pins-chevron-card__heading govuk-heading-s">
				<a class="govuk-link pins-chevron-card__link" href="{{ href }}">{{ title }}</a>
			</h3>
			<p class="govuk-body pins-chevron-card__description">{{ description }}</p>
		</div>
	</div>
{% endmacro %}


{% macro chevronDisplay(chevrons)  %}
	<div class="full-width-line full-width-line--bg-blue"></div>
	<section
		class="page-section full-width-section full-width-section--bg-lightgrey govuk-!-margin-bottom-6 govuk-!-padding-top-6">
		<div class="page-section__content">
			{% for item in chevrons %}
				{% if loop.index0 % 2 == 0 %}
					<div class="govuk-grid-row">
				{% endif %}
				<div class="govuk-grid-column-one-half">
					{{ chevronCard(item.title, item.href, item.description) }}
				</div>
				{% if loop.index0 % 2 == 1 or loop.last %}
					</div>
				{% endif %}
			{% endfor %}
		</div>
	</section>
    </div>
{% endmacro %}