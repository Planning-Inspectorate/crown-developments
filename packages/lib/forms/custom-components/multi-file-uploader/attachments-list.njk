{# Render a list of attachments as an ordered list. Items is an array of { href, name }, href optional #}
<ol class="govuk-list govuk-list--number">
	{% for item in items %}
		<li>
			{% if item.href %}
				<a href="{{ item.href | e }}" class="govuk-link govuk-link--no-visited-state" target="_blank"
					 rel="noopener noreferrer">{{ item.name | e }}</a>
			{% else %}
				{{ item.name | e }}
			{% endif %}
		</li>
	{% endfor %}
</ol>
