{% extends "views/layouts/main.njk" %}
{% from "views/layouts/components/case-notes.njk" import caseNotes %}

{% set title = reference + " - Case notes" %}

{% block pageTitle %}
	{{ title }}
{% endblock %}

{% block content %}
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-full">
			<h1 class="govuk-heading-l" data-cy="page-heading">
				Add a case note
			</h1>
		</div>
	</div>
	{{ caseNotes({
			currentUrl: currentUrl,
			notes: notes,
			max: 4,
			totalNotes: allCaseNotesCount,
			_csrf: _csrf,
			buttonText: "Save",
			buttonFormat: "govuk-button govuk-button--primary"
		}) }}
{% endblock %}
