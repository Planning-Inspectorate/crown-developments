+
+    it('should record nothing when a waste type is unchanged', () => {
+        assert.deepStrictEqual(resolveWasteTypeAudits(CASE_ID, USER_ID, [wasteType()], [wasteType()]), []);
+    });
+
+    it('should record a type change using the original type', () => {
