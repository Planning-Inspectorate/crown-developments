+    });
+
+    it('should read the Other text from the nested key too', () => {
+        assert.strictEqual(
+            getAdditionalContactType({
+                additionalContactType: 'other',
+                additionalContactType_otherContactType: 'acquiring authority'
+            }),
+            'Other: acquiring authority'
