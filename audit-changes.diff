+
+        assert.deepStrictEqual(entries, [
+            {
+                caseId: CASE_ID,
+                userId: USER_ID,
+                action: S62A_AUDIT_ACTIONS.WASTE_TYPE_DELETED,
+                metadata: { name: WITH_CAPACITY.displayName }
+            }
+        ]);
