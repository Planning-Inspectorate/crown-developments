+        voidCapacityUnitId: WASTE_UNIT_ID.CUBIC_METRES,
+        [`voidCapacityUnitId_${WASTE_UNIT_ID.CUBIC_METRES}`]: '1',
+        maxAnnualThroughputUnitId: WASTE_UNIT_ID.TONNES,
