+const USER_ID = 'user-1';
+
+// Uses entries from the seed data, so the tests don't depend on specific IDs
+const [USE_ONE, USE_TWO] = USE_CLASSES.filter((useClass) => useClass.id !== USE_CLASS_ID.OTHER);
