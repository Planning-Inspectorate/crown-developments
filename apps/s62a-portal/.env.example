# the log level for pino
LOG_LEVEL=debug

# a secret used for sessions
SESSION_SECRETS='["not-a-session-secret-one", "not-a-session-secret-2"]'

#GovNotify
S62A_GOV_NOTIFY_DISABLED=false
S62A_GOV_NOTIFY_API_KEY=not-a-real-api-key
S62A_DEV_CONTACT_EMAIL=an-email
GOV_NOTIFY_PRE_ACK_TEMPLATE_ID=<id>
GOV_NOTIFY_ACK_REP_TEMPLATE_ID=<id>

# Database
SQL_CONNECTION_STRING="sqlserver://localhost:1433;database=pins_crown_dev;user=sa;password=DockerDatabaseP@22word!;trustServerCertificate=true"

# Blob store for Have your say attachments. To upload locally, set BLOB_STORE_DISABLED=false
# and copy BLOB_STORE_HOST, BLOB_STORE_CONTAINER and BLOB_STORE_CONNECTION_STRING from the manage app's .env
BLOB_STORE_DISABLED=true

# Feature flags
FEATURE_FLAG_S62A_PORTAL_NOT_LIVE=false
