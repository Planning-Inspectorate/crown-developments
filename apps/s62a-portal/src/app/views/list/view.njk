{% extends "views/layouts/main.njk" %}

{% from "tables/tables.njk" import baseCaseListTable, basePortalHeaders, basePortalColumns %}
{% from "search-bar/search-bar.njk" import searchBar %}

{% import "pagination/pagination.njk" as pagination %}
{% import "pagination/pagination-options.njk" as paginationOptions %}


{% block pageHeading %}{% endblock %}

{% set s62aPortalHeaders = basePortalHeaders.concat([{ text: "Site location" }]) %}

{% set s62aPortalColumns = [
	{
		field: "referenceLink",
		sortField: "reference"
	},
	{
		field: "applicantOrganisations"
	},
	{
		field: "lpaFormatted",
		classes: "pins-white-space-pre-wrap"
	},
	{
		field: "location" 
	}
] %}

{% block containerStart %}
	<div class="govuk-width-container">
		{% include "views/layouts/components/core/intro-to-service.njk" %}
	</div>
	{{ super() }}
{% endblock %}

{% block pageContent %}
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-full">
			<h2 class="govuk-heading-l">
				{{ pageTitle }}
			</h2>
			<p class="govuk-body">
				This is a list of all applications. To find a specific application, use the filter or search by applicant, local authority, reference or location.
			</p>
		</div>
	</div>

	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds">
			<form id="search-bar-form" method="GET" action="{{ baseUrl }}">
				{% for param in carriedParams %}
					<input type="hidden" name="{{ param.name }}" value="{{ param.value }}">
				{% endfor %}
				{{ searchBar({
					input: {
						label: {
							text: "Search applications",
							isSubheading: true,
							classes: "govuk-label govuk-label--m"
						},
						hint: {
							text: "Search by reference, applicant, local authority or postcode."
						},
						classes: "govuk-input govuk-input--width-20"
					},
					button: {
						text: "Search",
						classes: "govuk-button"
					}
				}, searchValue) }}
			</form>
			{% if searchValue and s62aDevelopmentsViewModels | length > 0 %}
				<p class="govuk-body">
					<a href="{{ baseUrl }}" class="govuk-link govuk-link--no-visited-state">Clear search</a>
				</p>
			{% endif %}
		</div>
	</div>

	<div class="govuk-grid-row">
		<div class="govuk-grid-column-full">
			{% if searchValue and s62aDevelopmentsViewModels | length == 0 %}
				<p class="govuk-body">No results were found matching your search terms.</p>
				<p class="govuk-body">
					<a href="{{ baseUrl }}" class="govuk-link govuk-link--no-visited-state">Clear search</a> to view all applications.
				</p>
			{% else %}
				<div id="pagination">
					<p class="govuk-body govuk-clearfix">
						Showing <strong>{{ paginationParams.resultsStartNumber }}</strong>
						to
						<strong>{{ paginationParams.resultsEndNumber if paginationParams.totalItems > paginationParams.resultsEndNumber else paginationParams.totalItems }}</strong>
						of <strong>{{ paginationParams.totalItems }}</strong> results
					</p>
					{{ paginationOptions.renderPagination(paginationParams.selectedItemsPerPage, paginationParams.totalItems, baseUrl, queryParams) }}
					<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

					{{ baseCaseListTable(s62aDevelopmentsViewModels, s62aPortalHeaders, s62aPortalColumns) }}
				</div>

				{# if pageNumber and totalPages values are both 1 then pagination options not shown #}
				{{ pagination.renderPagination(paginationParams.pageNumber, paginationParams.totalPages, baseUrl, queryParams) }}
			{% endif %}
		</div>
	</div>
{% endblock %}
