{% from "application-stage/application-stage.njk" import stageItem %}

{% macro renderS62aApplicationStages(currentStage, applicationStages, s62aFields, haveYourSayStatus, haveYourSayDeadline) %}
	<h2 id="application-stage" class="govuk-heading-m">Application stage</h2>

	{% if currentStage %}
		<p class="govuk-body">This application is at the <b>{{ currentStage.stageDisplayName | lower }}</b> stage.</p>

		{% if currentStage.stageId === 'consultation' %}
			<p class="govuk-body">At this stage, you can have your say about the application.</p>
			{% if haveYourSayStatus === 'open' and s62aFields.applicationStatus !== 'withdrawn' and s62aFields.applicationStatus !== 'expired' %}
				<p class="govuk-body"><a class="govuk-link" href="have-your-say"> Comment on the proposed development by {{ haveYourSayDeadline }}.</a></p>
			{% endif %}
		{% endif %}
	{% endif %}

	<div id="application-stages">
		{% for stage in applicationStages %}
			{{ stageItem(stage) }}
		{% endfor %}
	</div>

	<br>
	<p class="govuk-body">Get more
		<a class="govuk-link" href="https://www.gov.uk/guidance/planning-applications-s62a" target="_blank">information about Section 62A applications (opens in a new tab)</a>.</p>
{% endmacro %}
