{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds">
			<p class="govuk-body">Your answers are not saved. This is because you did not submit your comment within 24 hours of starting it.</p>
			{{ govukButton({
				text: "Start again",
				href: startUrl
			}) }}
			<p class="govuk-body">
				<a class="govuk-link" href="{{ applicationUrl }}">Back to application</a>
			</p>
		</div>
	</div>
{% endblock %}
