{# The content above the upload on the 'Upload supporting attachments' page #}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% import "custom-components/representation-information/index.njk" as representationInformation %}

<p class="govuk-body">We'll publish your supporting attachments on the website alongside your name and comment, unless you have asked for your name to be withheld.</p>

{{ govukInsetText({
	text: "Do not include personal information that could identify you or another person in your attachments."
}) }}

{% set fileTypes = [] %}
{% for extension in question.allowedFileExtensions %}
	{% set fileTypes = (fileTypes.push(extension | upper), fileTypes) %}
{% endfor %}
<p class="govuk-body">File types you can upload:<br>{{ fileTypes | join(", ") }}</p>

<p class="govuk-body">File rules:</p>
<ul class="govuk-list govuk-list--bullet">
	<li>Do not compress files - we cannot accept ZIP files</li>
	<li>Each file must be under {{ question.maxFileSizeString }}</li>
	<li>Total upload size must be under 1GB</li>
</ul>

<p class="govuk-body">The file name can only include:</p>
<ul class="govuk-list govuk-list--bullet">
	<li>Letters, numbers, hyphens, underscores, brackets, ampersand and single apostrophes</li>
</ul>

{{ representationInformation.renderRepresentationInformation("Guidance on what not to include") }}

<h2 class="govuk-heading-m">Upload an attachment</h2>
