{% extends "views/layouts/main.njk" %}
{% from "govuk/components/accordion/macro.njk" import govukAccordion %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "tables/tables.njk" import documentsTable %}
{% import "pagination/pagination.njk" as pagination %}
{% import "pagination/pagination-options.njk" as paginationOptions %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% set title = reference + " - Case Folder" %}

{% block pageTitle %}
    {{ title }}
{% endblock %}

{% block content %}
	{% if banner %}
		<div class="govuk-grid-row">
			<div class="govuk-grid-column-two-thirds">
				{{ govukNotificationBanner(banner) }}
			</div>
		</div>
	{% endif %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full govuk-!-margin-bottom-3">
            <span class="govuk-caption-l" data-cy="case-reference">
                {{ reference }}
            </span>
            <h1 class="govuk-heading-l" data-cy="folder-name-heading">
                {{ folderName }} folder
            </h1>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            {% if subFolders|length !== 0 %}
                {% set subFoldersHtml %}
                    <div class="pins-link-menu">
                        <ul class="govuk-list">
                            {% for folder in subFolders %}
                                <li>
                                    <a class="govuk-link govuk-heading-s" href="{{ baseFoldersUrl }}/{{ folder.id }}/{{ folder.encodedDisplayName }}" data-cy="subfolder-link-{{ folder.id }}">
                                        {{ folder.displayName }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endset %}

                {{ govukAccordion({
                    id: "sub-folders-accordion",
                    classes: "hide-controls",
                    hideAllSections: true,
                    showSectionText: "Show subfolders",
                    hideSectionText: "Hide subfolders",
                    items: [
                        {
                            content: {
                                html: subFoldersHtml
                            }
                        }
                    ],
                    attributes: { "data-cy": "subfolders-accordion" }
                }) }}
            {% endif %}
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h2 class="govuk-heading-m">File actions</h2>

            {% if documents|length !== 0 %}
                <div id="pagination-top" class="govuk-body govuk-!-margin-bottom-2">
                    <p class="govuk-body govuk-clearfix">
                        This folder contains {{ paginationParams.totalItems }} files.
                        Showing <strong>{{ paginationParams.resultsStartNumber }}</strong>
                        to
                        <strong>{{ paginationParams.resultsEndNumber if paginationParams.totalItems > paginationParams.resultsEndNumber else paginationParams.totalItems }}</strong>
                        of <strong>{{ paginationParams.totalItems }}</strong> files.
                    </p>

                    {{ paginationOptions.renderPagination(paginationParams.selectedItemsPerPage, paginationParams.totalItems, baseUrl, queryParams) }}
                </div>
            {% endif %}
            <form method="POST">
                {% if _csrf %}<input type="hidden" name="_csrf" value="{{ _csrf }}">{% endif %}
                <input type="hidden" name="returnUrl" value="{{ currentPath }}">
                <input type="hidden" name="caseId" value="{{ caseId }}">

                <div class="govuk-button-group govuk-!-margin-top-4">
                    {{ govukButton({
                        text: "Upload files",
                        href: currentPath + "/upload",
                        classes: "govuk-button--secondary",
                        attributes: { "data-cy": "upload-files-btn" }
                    }) }}
                    {% if documents|length !== 0 %}
                        {{ govukButton({
                            text: "Download selected",
                            classes: "govuk-button--secondary",
                            attributes: {
                                "data-cy": "download-files-btn",
                                "formaction": currentPath + "/download/documents"
                            }
                        }) }}
                        {{ govukButton({
                            text: "Delete selected",
                            classes: "govuk-button--secondary",
                            attributes: {
                                "data-cy": "delete-files-btn",
                                "formaction": currentPath + "/delete/documents/confirmation"
                            }
                        }) }}
                    {% endif %}
                </div>

                {% if documents|length !== 0 %}
                    <!-- Polite aria so that screen readers will gently let the user know when this number changes -->
                    <p id="selection-count-container" class="govuk-body govuk-!-display-none govuk-!-margin-bottom-4" aria-live="polite">
                        <span id="selection-count-number">0</span> file(s) on this page selected
                    </p>

                    {{ documentsTable(documents, true) }}

                    {{ pagination.renderPagination(paginationParams.pageNumber, paginationParams.totalPages, baseUrl, queryParams) }}
                {% endif %}
            </form>

        </div>
    </div>

    <script type="module" {% if cspNonce %}nonce="{{ cspNonce }}"{% endif %}>
        document.addEventListener('DOMContentLoaded', function() {
            const selectAll = document.getElementById('checkboxes-all');
            const checkboxes = document.querySelectorAll('input[name="selectedFiles"]');
            const countContainer = document.getElementById('selection-count-container');
            const countNumber = document.getElementById('selection-count-number');

            if (countContainer && checkboxes.length > 0) {
                countContainer.classList.remove('govuk-!-display-none');
            }

            function updateCount() {
                const selectedCount = document.querySelectorAll('input[name="selectedFiles"]:checked').length;
                if (countNumber) {
                    countNumber.textContent = selectedCount;
                }
            }

            updateCount();

            if (selectAll) {
                selectAll.addEventListener('change', function(e) {
                    checkboxes.forEach(function(cb) {
                        cb.checked = e.target.checked;
                    });
                    updateCount();
                });

                checkboxes.forEach(function(cb) {
                    cb.addEventListener('change', function() {
                        const allChecked = Array.from(checkboxes).every(c => c.checked);
                        selectAll.checked = allChecked;
                        updateCount();
                    });
                });
            }
        });
    </script>
{% endblock %}
