{
  "name": "crown-developments",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check-types": "npx tsc",
    "commitlint": "commitlint --from=$(git rev-parse $(git cherry origin/main | head -n 1 | cut -c 3-)^1)",
    "db-migrate-dev": "npm run migrate-dev --workspace @pins/crowndev-database",
    "db-migrate-prod": "npm run migrate-prod --workspace @pins/crowndev-database",
    "db-generate": "npm run generate --workspace @pins/crowndev-database",
    "db-seed": "npm run seed --workspace @pins/crowndev-database",
    "db-seed-prod": "npm run seed:prod --workspace @pins/crowndev-database",
    "format": "npm run format:prettier && npm run format:css",
    "format:prettier": "prettier --write .",
    "format:css": "stylelint \"**/*.{css,scss}\" --fix",
    "format-check": "prettier --check .",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "npx eslint .",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "prepare": "node .husky/install.mjs",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:smoke": "cross-env JOURNEY_TAGS=smoke playwright test",
    "test:playwright:smoke:headed": "cross-env JOURNEY_TAGS=smoke playwright test --headed",
    "test:playwright:regression": "cross-env JOURNEY_TAGS=regression playwright test",
    "test:playwright:regression:headed": "cross-env JOURNEY_TAGS=regression playwright test --headed"
  },
  "dependencies": {
    "@azure/ai-text-analytics": "^5.1.0",
    "@azure/identity": "^4.13.1",
    "@azure/msal-node": "^5.4.3",
    "@azure/storage-blob": "^12.33.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@ministryofjustice/frontend": "^9.0.0",
    "@planning-inspectorate/dynamic-forms": "^3.18.1",
    "@prisma/adapter-mssql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "accessible-autocomplete": "^3.0.1",
    "archiver": "^8.0.0",
    "body-parser": "^2.3.0",
    "cfb": "^1.2.2",
    "connect-redis": "^10.0.0",
    "cookie": "^2.0.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "file-type": "^22.0.1",
    "govuk-frontend": "^6.3.0",
    "helmet": "^8.3.0",
    "lusca": "^1.7.0",
    "multer": "^2.2.0",
    "notifications-node-client": "^8.4.0",
    "nunjucks": "^3.2.4",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@planning-inspectorate/coding-standards": "^1.1.1",
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/lusca": "^1.7.5",
    "@types/multer": "^2.2.0",
    "@types/nunjucks": "^3.2.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^7.9.1",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.{css,scss}": [
      "stylelint --fix"
    ],
    "*.{js,ts,json,md,prisma,yml,yaml,scss}": [
      "prettier --write"
    ]
  }
}